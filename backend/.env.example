# ─── Database ────────────────────────────────────────────────────────────────
# Any hosted Postgres works. Vercel/Neon injects POSTGRES_URL automatically when
# you add a Neon database to the project, so DATABASE_URL is optional there.
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ─── Auth (set strong random values in production) ───────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
# Required for verifying Google Sign-In ID tokens cryptographically via google-auth-library
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
# Comma-separated list of allowed frontend origins (your Vercel frontend URL)
FRONTEND_URL=https://valano-shop.vercel.app

# ─── Email Service (Resend) ──────────────────────────────────────────────────
# Default sender before custom domain verification: onboarding@resend.dev
RESEND_API_KEY=re_paste_your_resend_key_here
RESEND_FROM=onboarding@resend.dev
ADMIN_ALERT_EMAIL=umuhozanews@gmail.com

# ─── Optional: SMTP fallback ─────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="INZIRA Insights" <no-reply@inzira.rw>

# ─── Cloud Storage (Cloudinary) ────────────────────────────────────────────────
# Configures Cloudinary image upload storage for receipts and store logos.
# Use CLOUDINARY_URL or specify CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
