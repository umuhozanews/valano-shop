# DataBridge mobile app configuration
#
# In development, the Vite dev server proxies /api to a backend. Choose the
# target with VITE_DEV_API_PROXY (defaults to http://localhost:5000):
#   - Local backend:    VITE_DEV_API_PROXY=http://localhost:5000
#   - Deployed backend: VITE_DEV_API_PROXY=https://backend-chi-olive-97.vercel.app
#
# In production (e.g. Vercel), set VITE_API_URL to the SAME backend the main
# Inzira Insights app uses, so both clients share one database.
#
# VITE_API_URL=https://backend-chi-olive-97.vercel.app/api
